{
  "info": {
    "_postman_id": "a9d59041-9492-411e-920b-e483582be611",
    "name": "Bluestock FinTech Data Analytics - REST API Collection",
    "description": "Collection of financial market REST API requests configured for Postman and Bruno. Includes query parameters, headers, and automated test assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Real-Time Market Assets (INR)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "User-Agent",
            "value": "Bluestock-Fintech-Client/1.0",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://api.coingecko.com/api/v3/coins/markets?vs_currency=inr&order=market_cap_desc&per_page=25&page=1&sparkline=false&price_change_percentage=24h",
          "protocol": "https",
          "host": [
            "api",
            "coingecko",
            "com"
          ],
          "path": [
            "api",
            "v3",
            "coins",
            "markets"
          ],
          "query": [
            {
              "key": "vs_currency",
              "value": "inr",
              "description": "The target currency of market data (Indian Rupee)"
            },
            {
              "key": "order",
              "value": "market_cap_desc",
              "description": "Sort results by market capitalization descending"
            },
            {
              "key": "per_page",
              "value": "25",
              "description": "Total number of records per page"
            },
            {
              "key": "page",
              "value": "1",
              "description": "Page number for pagination"
            },
            {
              "key": "sparkline",
              "value": "false",
              "description": "Exclude 7-day sparkline array to keep payload lightweight"
            },
            {
              "key": "price_change_percentage",
              "value": "24h",
              "description": "Include 24-hour price change percentage"
            }
          ]
        },
        "description": "Retrieves top 25 financial market assets denominated in INR with 24h high/low, trading volume, and market cap."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Verify dataset contains 25 items\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.eql(25);",
              "});",
              "",
              "pm.test(\"Verify financial schema properties\", function () {",
              "    var jsonData = pm.response.json();",
              "    var firstItem = jsonData[0];",
              "    pm.expect(firstItem).to.have.property(\"symbol\");",
              "    pm.expect(firstItem).to.have.property(\"current_price\");",
              "    pm.expect(firstItem).to.have.property(\"market_cap\");",
              "    pm.expect(firstItem).to.have.property(\"total_volume\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Ping API Server Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://api.coingecko.com/api/v3/ping",
          "protocol": "https",
          "host": [
            "api",
            "coingecko",
            "com"
          ],
          "path": [
            "api",
            "v3",
            "ping"
          ]
        },
        "description": "Verifies API server status and network latency."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response time is under 1500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
